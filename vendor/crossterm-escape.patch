+#[cfg(test)]
+mod akasha_escape_tests {
+    use super::*;
+    use crate::event::{KeyCode, KeyModifiers};
+
+    fn key(code: KeyCode) -> InternalEvent {
+        InternalEvent::Event(Event::Key(code.into()))
+    }
+
+    #[test]
+    fn fragmented_paste_is_one_exact_event() {
+        let now = Instant::now();
+        let mut parser = Parser::default();
+        let bytes = "\x1b[200~Привет 世界 e\u{301}\n\x1b[201~".as_bytes();
+        for (index, byte) in bytes.iter().enumerate() {
+            parser.advance_at(&[*byte], now + Duration::from_millis(index as u64 * 2));
+            if index + 1 < bytes.len() {
+                assert_eq!(parser.next(), None);
+            }
+        }
+        assert_eq!(
+            parser.next(),
+            Some(InternalEvent::Event(Event::Paste(
+                "Привет 世界 e\u{301}\n".into()
+            )))
+        );
+        assert_eq!(parser.next(), None);
+    }
+
+    #[test]
+    fn escape_deadline_survives_short_polls_and_expires_once() {
+        let now = Instant::now();
+        let mut parser = Parser::default();
+        parser.advance_at(b"\x1b", now);
+        assert_eq!(parser.poll_timeout(None, now), Some(ESCAPE_TIMEOUT));
+        assert_eq!(
+            parser.poll_timeout(Some(Duration::ZERO), now),
+            Some(Duration::ZERO)
+        );
+        assert_eq!(
+            parser.poll_timeout(Some(Duration::from_millis(20)), now),
+            Some(Duration::from_millis(20))
+        );
+        parser.expire_escape(now + Duration::from_millis(249));
+        assert_eq!(parser.next(), None);
+        parser.expire_escape(now + ESCAPE_TIMEOUT);
+        assert_eq!(parser.next(), Some(key(KeyCode::Esc)));
+        parser.expire_escape(now + ESCAPE_TIMEOUT * 2);
+        assert_eq!(parser.next(), None);
+        assert_eq!(parser.poll_timeout(None, now + ESCAPE_TIMEOUT), None);
+    }
+
+    #[test]
+    fn late_suffix_is_not_reinterpreted_as_a_paste() {
+        let now = Instant::now();
+        let mut parser = Parser::default();
+        parser.advance_at(b"\x1b", now);
+        parser.advance_at(b"[", now + ESCAPE_TIMEOUT);
+        assert_eq!(parser.next(), Some(key(KeyCode::Esc)));
+        assert_eq!(parser.next(), Some(key(KeyCode::Char('['))));
+        assert_eq!(parser.next(), None);
+    }
+
+    #[test]
+    fn repeated_escape_and_ordinary_keys_keep_order() {
+        let now = Instant::now();
+        let mut parser = Parser::default();
+        parser.advance_at(b"a\x1b\x1b", now);
+        assert_eq!(parser.next(), Some(key(KeyCode::Char('a'))));
+        assert_eq!(parser.next(), Some(key(KeyCode::Esc)));
+        assert_eq!(parser.next(), None);
+        parser.expire_escape(now + ESCAPE_TIMEOUT);
+        assert_eq!(parser.next(), Some(key(KeyCode::Esc)));
+    }
+
+    #[test]
+    fn split_arrow_and_alt_keys_cancel_the_escape_deadline() {
+        let now = Instant::now();
+        let mut parser = Parser::default();
+        parser.advance_at(b"\x1b", now);
+        parser.advance_at(b"[A", now + Duration::from_millis(150));
+        assert_eq!(parser.next(), Some(key(KeyCode::Up)));
+        parser.advance_at(b"\x1b", now);
+        parser.advance_at(b"x", now + Duration::from_millis(150));
+        assert_eq!(
+            parser.next(),
+            Some(InternalEvent::Event(Event::Key(
+                crate::event::KeyEvent::new(KeyCode::Char('x'), KeyModifiers::ALT)
+            )))
+        );
+        parser.expire_escape(now + ESCAPE_TIMEOUT);
+        assert_eq!(parser.next(), None);
+    }
+
+    #[cfg(not(feature = "libc"))]
+    #[test]
+    fn blocking_input_respects_short_poll_and_escape_deadline() {
+        use std::io::Write;
+        use std::os::unix::net::UnixStream;
+        let (input, mut output) = UnixStream::pair().unwrap();
+        let mut source =
+            UnixInternalEventSource::from_file_descriptor(FileDesc::Owned(input.into())).unwrap();
+        // Fail promptly if a sandbox forbids local socket writes.
+        output.write_all(b"\x1b").unwrap();
+        // Release even a regressed blocking second read, so this test fails rather than hangs.
+        let guard = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(800));
+            let _ = output.write_all(b"x");
+        });
+        let started = Instant::now();
+        assert_eq!(
+            source.try_read(Some(Duration::from_millis(40))).unwrap(),
+            None
+        );
+        assert!(started.elapsed() < Duration::from_millis(200));
+        assert_eq!(source.try_read(None).unwrap(), Some(key(KeyCode::Esc)));
+        assert!(started.elapsed() >= ESCAPE_TIMEOUT);
+        assert!(started.elapsed() < Duration::from_millis(700));
+        guard.join().unwrap();
+    }
+}
